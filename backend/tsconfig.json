  "compilerOptions": {
    "target": "ES2020",         /* This fixes the Set/Map iteration error */
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "downlevelIteration": true, /* Extra safety for iterations */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,            /* Keeps things "easy" for now */
    "noImplicitAny": false      /* Prevents 'any' errors from crashing build */
  }
}
